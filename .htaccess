<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

RewriteEngine On

Options -Indexes

# Bloquear acceso directo a código, dependencias y archivos de documentación/BD
RewriteRule ^(app|vendor)/ - [F,L]
RewriteRule \.(sql|md|lock|json)$ - [F,L]

# Archivos ocultos (.env, .git, .gitignore) y el esquema de la BD
RewriteRule (^|/)\.(?!well-known) - [F,L]
RewriteRule ^modelo_relacional\.svg$ - [F,L]

# Si el archivo o carpeta solicitado existe físicamente, acceder directamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Si no existe, redirigir la URL limpia al index.php preservando los parámetros GET ([QSA])
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]