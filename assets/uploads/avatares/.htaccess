Options -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar

<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
